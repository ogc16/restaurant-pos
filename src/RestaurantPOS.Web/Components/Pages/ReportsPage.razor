@page "/reports"
@rendermode InteractiveServer
@inject ApiService Api
@inject IJSRuntime JS

<div class="dashboard">
    <div class="dashboard-header">
        <h1>Reports & Analytics</h1>
    </div>
    <div class="toolbar">
        <div class="filter-group">
            <label>From:</label>
            <input type="date" @bind="startDate" />
        </div>
        <div class="filter-group">
            <label>To:</label>
            <input type="date" @bind="endDate" />
        </div>
        <div class="filter-group">
            <label>Report Type:</label>
            <select @bind="reportType">
                <option value="daily">Daily</option>
                <option value="weekly">Weekly</option>
                <option value="monthly">Monthly</option>
            </select>
        </div>
        <button class="btn btn-primary btn-sm" @onclick="LoadReport">Load Report</button>
        <button class="btn btn-outline btn-sm" @onclick="ExportCsv">Export CSV</button>
    </div>

    @if (dailyReport != null && reportType == "daily")
    {
        <div class="stats-grid">
            <div class="stat-card"><h3>Total Orders</h3><div class="value">@dailyReport.TotalOrders</div></div>
            <div class="stat-card success"><h3>Total Revenue</h3><div class="value">$@dailyReport.TotalRevenue.ToString("N2")</div></div>
            <div class="stat-card warning"><h3>Total Tips</h3><div class="value">$@dailyReport.TotalTips.ToString("N2")</div></div>
            <div class="stat-card"><h3>Items Sold</h3><div class="value">@dailyReport.ItemsSold</div></div>
        </div>

        <div class="card">
            <div class="card-header"><h2>Top Selling Items</h2></div>
            <table>
                <thead><tr><th>Item</th><th>Qty Sold</th><th>Revenue</th></tr></thead>
                <tbody>
                @foreach (var item in dailyReport.TopSellingItems)
                {
                    <tr><td>@item.Name</td><td>@item.QuantitySold</td><td>$@item.Revenue.ToString("N2")</td></tr>
                }
                </tbody>
            </table>
        </div>
    }

    @if (weeklyReports != null && reportType == "weekly")
    {
        <div class="stats-grid">
            <div class="stat-card"><h3>Total Days</h3><div class="value">@weeklyReports.Count</div></div>
            <div class="stat-card success"><h3>Total Revenue</h3><div class="value">$@weeklyReports.Sum(r => r.TotalRevenue).ToString("N2")</div></div>
            <div class="stat-card warning"><h3>Total Tips</h3><div class="value">$@weeklyReports.Sum(r => r.TotalTips).ToString("N2")</div></div>
            <div class="stat-card"><h3>Items Sold</h3><div class="value">@weeklyReports.Sum(r => r.ItemsSold)</div></div>
        </div>

        <div class="card">
            <div class="card-header"><h2>Daily Breakdown</h2></div>
            <table>
                <thead><tr><th>Date</th><th>Orders</th><th>Revenue</th><th>Tips</th><th>Items</th></tr></thead>
                <tbody>
                @foreach (var r in weeklyReports)
                {
                    <tr><td>@r.Date.ToString("MMM dd")</td><td>@r.TotalOrders</td><td>$@r.TotalRevenue.ToString("N2")</td><td>$@r.TotalTips.ToString("N2")</td><td>@r.ItemsSold</td></tr>
                }
                </tbody>
            </table>
        </div>
    }

    @if (monthlyReports != null && reportType == "monthly")
    {
        <div class="stats-grid">
            <div class="stat-card"><h3>Total Days</h3><div class="value">@monthlyReports.Count</div></div>
            <div class="stat-card success"><h3>Total Revenue</h3><div class="value">$@monthlyReports.Sum(r => r.TotalRevenue).ToString("N2")</div></div>
            <div class="stat-card warning"><h3>Total Tips</h3><div class="value">$@monthlyReports.Sum(r => r.TotalTips).ToString("N2")</div></div>
            <div class="stat-card"><h3>Items Sold</h3><div class="value">@monthlyReports.Sum(r => r.ItemsSold)</div></div>
        </div>

        <div class="card">
            <div class="card-header"><h2>Daily Breakdown</h2></div>
            <table>
                <thead><tr><th>Date</th><th>Orders</th><th>Revenue</th><th>Tips</th><th>Items</th></tr></thead>
                <tbody>
                @foreach (var r in monthlyReports)
                {
                    <tr><td>@r.Date.ToString("MMM dd")</td><td>@r.TotalOrders</td><td>$@r.TotalRevenue.ToString("N2")</td><td>$@r.TotalTips.ToString("N2")</td><td>@r.ItemsSold</td></tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private DateTime startDate = DateTime.Today.AddDays(-7);
    private DateTime endDate = DateTime.Today;
    private string reportType = "daily";
    private DailyReport? dailyReport;
    private List<DailyReport>? weeklyReports;
    private List<DailyReport>? monthlyReports;

    protected override async Task OnInitializedAsync() => await LoadReport();

    private async Task LoadReport()
    {
        dailyReport = null;
        weeklyReports = null;
        monthlyReports = null;

        switch (reportType)
        {
            case "daily":
                dailyReport = await Api.GetSingleAsync<DailyReport>($"api/reports/daily?date={startDate:yyyy-MM-dd}");
                break;
            case "weekly":
                weeklyReports = await Api.GetAsync<DailyReport>($"api/reports/weekly?startDate={startDate:yyyy-MM-dd}");
                break;
            case "monthly":
                monthlyReports = await Api.GetAsync<DailyReport>($"api/reports/monthly?year={startDate.Year}&month={startDate.Month}");
                break;
        }
    }

    private async Task ExportCsv()
    {
        var bytes = await Api.GetBytesAsync($"api/reports/export?from={startDate:yyyy-MM-dd}&to={endDate:yyyy-MM-dd}");
        if (bytes != null)
        {
            var fileName = $"sales_{startDate:yyyyMMdd}_{endDate:yyyyMMdd}.csv";
            await JS.InvokeVoidAsync("downloadFile", fileName, bytes);
        }
    }

    record DailyReport(DateTime Date, int TotalOrders, decimal TotalRevenue, decimal TotalTips, int ItemsSold, List<TopItem> TopSellingItems);
    record TopItem(int MenuItemId, string Name, int QuantitySold, decimal Revenue);
}
