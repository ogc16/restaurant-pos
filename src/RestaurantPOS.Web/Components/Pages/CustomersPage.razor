@page "/customers"
@rendermode InteractiveServer
@inject ApiService Api

<div class="dashboard">
    <div class="dashboard-header">
        <h1>Customers</h1>
        <button class="btn btn-primary" @onclick="() => showCreateModal = true">+ Add Customer</button>
    </div>
    <div class="card">
        <table>
            <thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Loyalty Points</th><th>Notes</th><th>Actions</th></tr></thead>
            <tbody>
            @foreach (var c in customers)
            {
                <tr>
                    <td><strong>@c.FullName</strong></td>
                    <td>@(c.Email ?? "-")</td>
                    <td>@(c.Phone ?? "-")</td>
                    <td><span class="badge badge-info">@c.LoyaltyPoints pts</span></td>
                    <td>@(c.PreferredNotes ?? "-")</td>
                    <td><button class="btn btn-sm btn-danger" @onclick="() => DeleteCustomer(c.Id)">Delete</button></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@if (showCreateModal)
{
    <div class="modal-overlay" @onclick="() => showCreateModal = false">
        <div class="modal" @onclick:stopPropagation>
            <div class="modal-header"><h2>Add Customer</h2><button class="close-btn" @onclick="() => showCreateModal = false">&times;</button></div>
            <div class="form-group"><label>Full Name</label><input @bind="newCustomer.FullName" /></div>
            <div class="form-group"><label>Email</label><input @bind="newCustomer.Email" /></div>
            <div class="form-group"><label>Phone</label><input @bind="newCustomer.Phone" /></div>
            <div class="form-group"><label>Notes</label><input @bind="newCustomer.PreferredNotes" /></div>
            <button class="btn btn-primary btn-block" @onclick="CreateCustomer">Create</button>
        </div>
    </div>
}

@code {
    private List<CustomerDto> customers = new();
    private bool showCreateModal;
    private NewCustomer newCustomer = new();

    protected override async Task OnInitializedAsync() => customers = await Api.GetAsync<CustomerDto>("api/customers");

    private async Task CreateCustomer()
    {
        await Api.PostAsync<object>("api/customers", newCustomer);
        showCreateModal = false;
        newCustomer = new();
        customers = await Api.GetAsync<CustomerDto>("api/customers");
    }

    private async Task DeleteCustomer(int id)
    {
        await Api.DeleteAsync($"api/customers/{id}");
        customers = await Api.GetAsync<CustomerDto>("api/customers");
    }

    record CustomerDto(int Id, string FullName, string? Email, string? Phone, int LoyaltyPoints, string? PreferredNotes);
    class NewCustomer { public string FullName { get; set; } = ""; public string? Email { get; set; } public string? Phone { get; set; } public string? PreferredNotes { get; set; } }
}
