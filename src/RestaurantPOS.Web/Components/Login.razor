@inject AuthService Auth
@inject NavigationManager Nav

<div class="login-container">
    <div class="login-card">
        <h1>RestaurantPOS</h1>
        <p class="subtitle">Sign in to your account</p>
        
        @if (loginSuccess)
        {
            <p style="color:var(--success);text-align:center;margin-top:1rem;">Login successful! Redirecting...</p>
        }
        else
        {
            <EditForm Model="model" OnValidSubmit="HandleLogin">
                <div class="form-group">
                    <label>Email</label>
                    <InputText @bind-Value="model.Email" class="form-control" placeholder="admin@restaurant.com" />
                </div>
                <div class="form-group">
                    <label>Password</label>
                    <InputText type="password" @bind-Value="model.Password" class="form-control" placeholder="Password" />
                </div>
                @if (!string.IsNullOrEmpty(error))
                {
                    <p class="error-msg">@error</p>
                }
                <button type="submit" class="btn btn-primary btn-block mt-2" disabled="@loading">
                    @(loading ? "Signing in..." : "Sign In")
                </button>
            </EditForm>
        }
    </div>
</div>

@code {
    [Parameter] public EventCallback OnLoginSuccess { get; set; }

    private LoginModel model = new();
    private string error = "";
    private bool loading;
    private bool loginSuccess;

    private async Task HandleLogin()
    {
        loading = true;
        error = "";
        StateHasChanged();

        var success = await Auth.LoginAsync(model.Email, model.Password);
        if (success)
        {
            loginSuccess = true;
            StateHasChanged();
            await Task.Delay(300);
            await OnLoginSuccess.InvokeAsync();
        }
        else
        {
            error = "Invalid email or password";
            loading = false;
            StateHasChanged();
        }
    }

    private class LoginModel
    {
        public string Email { get; set; } = "admin@restaurant.com";
        public string Password { get; set; } = "Admin@123456";
    }
}
